{
	"name": "konomi",
	"description": "A WordPress plugin to save posts as favorite using the new Interactive API",
	"author": "guido scialfa <dev@guidoscialfa.com>",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">= 20"
	},
	"packageManager": "pnpm@10.33.0",
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@faker-js/faker": "^8",
		"@jest/globals": "^29.4.3",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/dom": "^9.3.1",
		"@testing-library/jest-dom": "^6.2.0",
		"@testing-library/react": "^14.0.0",
		"@testing-library/user-event": "^14.5.1",
		"@total-typescript/shoehorn": "^0.1.0",
		"@types/react": "~18.2.0",
		"@types/react-dom": "~18.2.0",
		"@wordpress/babel-preset-default": "^8.33.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^5.0.0",
		"@wordpress/env": "^10.9.0",
		"@wordpress/eslint-plugin": "^22.8.0",
		"@wordpress/prettier-config": "^4.33.0",
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/server-side-render": "^6.2.0",
		"@wordpress/stylelint-config": "^23.25.0",
		"babel-jest": "^29.7.0",
		"clean-webpack-plugin": "^4.0.0",
		"eslint": "^8.57.1",
		"eslint-import-resolver-typescript": "^3.5.5",
		"eslint-plugin-import": "^2.25.2",
		"jest": "^29.4.3",
		"jest-environment-jsdom": "^29.5.0",
		"playwright": "^1.62.1",
		"preact": "^10.24.2",
		"prettier": "npm:wp-prettier@3.0.3",
		"stylelint": "^16.25.0",
		"ts-node": "^10.9.1",
		"typescript": "~5.3.0",
		"typescript-eslint": "^7.10.0",
		"url-loader": "^4.1.1"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.1.0",
		"@wordpress/block-editor": "^14.18.0",
		"@wordpress/blocks": "^12.35.0",
		"@wordpress/components": "^28.4.0",
		"@wordpress/compose": "^6.35.0",
		"@wordpress/data": "^9.28.0",
		"@wordpress/i18n": "^4.57.0",
		"@wordpress/interactivity": "^6.1.0",
		"react": "~18.2.0",
		"react-dom": "~18.2.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"build": "pnpm build:scripts && pnpm build:modules",
		"build:scripts": "tsc --noEmit && wp-scripts build --config webpack.scripts.config.js",
		"build:modules": "tsc --noEmit && wp-scripts build --experimental-modules --config webpack.modules.config.js",
		"build:dev:scripts": "tsc --noEmit && wp-scripts start --config webpack.scripts.config.js --webpack--devtool=source-map",
		"build:dev:modules": "tsc --noEmit && wp-scripts start --experimental-modules --config webpack.modules.config.js --webpack--devtool=source-map",
		"build:blocks-manifest": "wp-scripts build-blocks-manifest --input=./sources/Blocks --output=./sources/Blocks/blocks-manifest.php",
		"cs:fix": "wp-scripts format ./sources ./@types",
		"lint:js": "wp-scripts lint-js ./sources ./@types",
		"lint:js:fix": "wp-scripts lint-js --fix ./sources ./@types",
		"lint:css": "wp-scripts lint-style ./sources/**/*.scss --ignore-path .stylelintignore --config .stylelintrc.json",
		"lint:css:fix": "wp-scripts lint-style ./sources/**/*.scss --fix",
		"lint:md": "wp-scripts lint-md-docs README.md ./docs",
		"lint:md:fix": "prettier --write --prose-wrap always --print-width 120 README.md \"./docs/**/*.md\" && wp-scripts lint-md-docs README.md ./docs --fix",
		"test": "jest",
		"test:update-snapshots": "pnpm test -u",
		"test:coverage": "jest --coverage",
		"qa": "tsc --noEmit && pnpm lint:js && pnpm lint:css && pnpm lint:md && pnpm test:coverage"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"unrs-resolver"
		]
	}
}
